{
  "name": "@opensurfer/runtime",
  "version": "0.1.0",
  "description": "Capability discovery and workflow execution engine for OpenSurfer Browser",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.esm.js"
    }
  },
  "scripts": {
    "build": "rollup -c rollup.config.js",
    "dev": "rollup -c rollup.config.js --watch",
    "test": "jest"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.8.3",
    "rollup": "^4.0.0",
    "@rollup/plugin-typescript": "^12.0.0",
    "tslib": "^2.8.0"
  },
  "license": "MIT"
}
